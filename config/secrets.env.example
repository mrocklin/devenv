# Copy to ~/.config/devenv/secrets.env and fill in real values.
# This file is sourced by ~/.zshrc. Never commit it.

# Anthropic
# export ANTHROPIC_API_KEY=

# Google OAuth (for various tools)
# export GOOGLE_CLIENT_ID=
# export GOOGLE_CLIENT_SECRET=

# Observability
# export GRAFANA_URL=
# export GRAFANA_TOKEN=
# export SIGNOZ_API_KEY=
# export LOGS_USER=
# export LOGS_PASSWORD_HASH=

# PostHog
# export POSTHOG_API_KEY=
