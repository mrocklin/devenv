# ~/.zshenv — sourced for all zsh invocations (incl. non-interactive).
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# SSH strips COLORTERM; re-declare so TUIs (claudechic, etc.) pick truecolor.
export COLORTERM=truecolor

# Login shell is bash (trampoline execs zsh); make $SHELL match reality so
# tools that read it (vim :sh, tmux, scripts) spawn zsh subshells.
export SHELL="$(command -v zsh)"
